* text=auto
*.cs text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.meta text eol=lf
# Unity serializes empty YAML values with trailing spaces.
*.asset whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
*.meta whitespace=-blank-at-eol
*.png binary
*.mp4 binary
